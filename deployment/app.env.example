NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=512
PORT=3001
WORKBENCH_DEV=0
WORKBENCH_PUBLIC_ORIGIN=https://your-host.example
WORKBENCH_PROXY_TOKEN=replace-with-at-least-32-random-characters
WORKBENCH_DATA_DIR=/var/lib/agent-workbench
WORKBENCH_SECRETS_FILE=/var/lib/agent-workbench/no-local-secrets
WORKBENCH_SPEND_LIMIT_USD=3
