{
  "version": 1,
  "consent": {
    "git_checkpoints": "auto",
    "fmea_full_scan": "auto",
    "paid_evals": "milestone_cap",
    "paid_evals_cap_usd": 3
  },
  "context_sources": {
    "prd_path": "planning/APP-BRIEF.md",
    "architecture_doc": "docs/ARCHITECTURE_FLOW.md",
    "incidents": "Learning.MD",
    "infra": "docs/AWS-READINESS.md"
  },
  "fmea": {
    "triggers": [
      "on_feature_complete",
      "on_pre_commit"
    ],
    "failure_categories": [
      "unhandled_error_paths",
      "external_dependency_failures",
      "race_conditions_and_state",
      "resource_exhaustion",
      "security_access_control",
      "data_integrity_partial_writes",
      "observability_gaps",
      "scale_and_load_failures",
      "billing_credit_mismatches",
      "retry_idempotency_issues",
      "config_feature_flag_drift",
      "edge_cases_from_prd"
    ]
  },
  "sentinel": {
    "enabled": true
  },
  "session_pulse": {
    "enabled": true
  },
  "debug": {
    "mode": "diagrams_only"
  },
  "security_baseline": {
    "status": "done",
    "verified_on": "2026-09-25"
  },
  "modules": {
    "security_baseline": {
      "done": true
    },
    "sentinel": {
      "enabled": true,
      "manual_only": false
    },
    "session_pulse": {
      "enabled": true
    }
  }
}
