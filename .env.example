# Zero-paid local development. Supply only local disposable PostgreSQL credentials.
PORT=8951
APP_URL=http://127.0.0.1:8951
PORTFOLIO_AUTH_ENABLED=1
AUTH_SECRET=
DATABASE_URL=
DATABASE_SSL=disable
# Production: remove DATABASE_SSL=disable and set a trusted CA file.
DATABASE_SSL_CA_FILE=
WORKBENCH_DATA_DIR=.local
WORKBENCH_STORAGE_MODE=fixture
WORKBENCH_PROVIDER_MODE=mock
WORKBENCH_SPEND_LIMIT_USD=0
WORKBENCH_SHARED_SPEND_LIMIT_USD=0.25
WORKBENCH_DEV=0
# Production operator settings; never commit real values.
WORKBENCH_PUBLIC_ORIGIN=
WORKBENCH_CONFIGURED_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
AWS_REGION=ap-south-1
PORTFOLIO_STORAGE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
